{
  "name": "@pi-agent-chatbot/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daemon that runs inside each Daytona sandbox: Convex client + Pi agent host.",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "spike:pi": "node build.mjs && node dist/spikePi.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "convex": "1.46.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
