# Copy to .env.local (gitignored) and fill in. `npm run env:push` copies the
# control-plane variables below into the Convex deployment.

# --- Written by `npx convex dev` (do not edit by hand) ---
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# --- Daytona (required) ---
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# Set automatically by `npm run snapshot`.
DAYTONA_SNAPSHOT=

# --- LLM (required). Injected into sandboxes; the agent runs in the VM. ---
OPENAI_API_KEY=
# Optional hardening: name of a Daytona org Secret holding the OpenAI key
# (allowed host api.openai.com). When set, the real key never enters a VM.
# DAYTONA_OPENAI_SECRET=
# Any OpenAI model id from pi-ai's registry.
# DEFAULT_MODEL=gpt-5.4-mini

# --- Web search (required). Stays in Convex; never enters a VM. ---
TAVILY_API_KEY=

# --- Lifecycle tuning (optional) ---
# Pre-booted sandboxes waiting for new threads. 0 = always cold start.
# SANDBOX_POOL_SIZE=1
# Stop a thread's sandbox after this many idle minutes.
# SANDBOX_IDLE_STOP_MINUTES=10
# Daytona auto-stop: the dead-man's switch if the control plane goes away.
# DAYTONA_AUTOSTOP_MINUTES=30
